From 96ae83b751226e942cc64b6ccdee8f7493b016e5 Mon Sep 17 00:00:00 2001
From: taehwankim <mrkiwi77@gmail.com>
Date: Thu, 8 Oct 2026 10:22:52 +0000
Subject: [PATCH] board: xilinx: zynq: read MAC address from QSPI OTP

Digilent Zynq boards (Zybo Z7, Arty Z7, ...) store a unique MAC
address in the OTP area of the QSPI flash. The Digilent u-boot fork
(digilent_rebase_v2022.01) read it through the removed
zynq_board_read_rom_ethaddr() hook. Re-implement it for
u-boot-xlnx 2025.2 in board_late_init(), which runs before
initr_net(), using raw spi-mem operations (1-1-1 OTP read) so the
QSPI quad read protocol does not interfere.

New options: CONFIG_ZYNQ_GEM_SPI_MAC_OTP, CONFIG_ZYNQ_GEM_SPI_MAC_OFFSET.
---
 board/xilinx/Kconfig      | 15 +++++++
 board/xilinx/zynq/board.c | 94 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 109 insertions(+)

diff --git a/board/xilinx/Kconfig b/board/xilinx/Kconfig
index f7152d6e..773bde65 100644
--- a/board/xilinx/Kconfig
+++ b/board/xilinx/Kconfig
@@ -40,6 +40,21 @@ config XILINX_PS_INIT_FILE
 
 endif
 
+config ZYNQ_GEM_SPI_MAC_OTP
+	bool "Read Ethernet MAC address from QSPI flash OTP area"
+	depends on ARCH_ZYNQ && DM_SPI_FLASH && SPI_MEM && NET
+	help
+	  Digilent boards (Zybo Z7, Arty Z7, ...) ship with a unique MAC
+	  address programmed into the OTP region of the QSPI flash. When
+	  enabled, board_late_init() reads it and sets "ethaddr" unless
+	  the saved environment already contains one. Supported flashes:
+	  Spansion S25FL128S, Micron N25Q128/MT25QL128 and Winbond W25Q128.
+
+config ZYNQ_GEM_SPI_MAC_OFFSET
+	hex "Offset of the MAC address inside the OTP area"
+	depends on ZYNQ_GEM_SPI_MAC_OTP
+	default 0x0
+
 config XILINX_MINI
 	bool "Mini configuration"
 	depends on ARCH_ZYNQMP || ARCH_VERSAL || ARCH_VERSAL_NET || ARCH_VERSAL2
diff --git a/board/xilinx/zynq/board.c b/board/xilinx/zynq/board.c
index a852d5b8..7639fb7f 100644
--- a/board/xilinx/zynq/board.c
+++ b/board/xilinx/zynq/board.c
@@ -20,6 +20,10 @@
 #include <watchdog.h>
 #include <wdt.h>
 #include <zynqpl.h>
+#include <net.h>
+#include <spi.h>
+#include <spi_flash.h>
+#include <spi-mem.h>
 #include <asm/global_data.h>
 #include <asm/arch/hardware.h>
 #include <asm/arch/sys_proto.h>
@@ -45,6 +49,92 @@ int board_init(void)
 	return 0;
 }
 
+#if IS_ENABLED(CONFIG_ZYNQ_GEM_SPI_MAC_OTP)
+#define OTP_READ_SPANSION_MICRON	0x4b	/* OTPR / READ OTP ARRAY */
+#define OTP_READ_WINBOND		0x48	/* Read Security Registers */
+#define OTP_BASE_SPANSION_MICRON	0x20
+#define OTP_BASE_WINBOND		0x1000	/* security register 1 */
+
+static void zynq_read_qspi_otp_mac(void)
+{
+	struct spi_flash *flash;
+	struct udevice *dev;
+	struct spi_mem_op op;
+	u8 opcode, jedec[3], mac[ARP_HLEN];
+	u32 id, addr;
+	int ret;
+
+	/* A MAC saved in the environment always wins */
+	if (env_get("ethaddr"))
+		return;
+
+	ret = spi_flash_probe_bus_cs(CONFIG_SF_DEFAULT_BUS,
+				     CONFIG_SF_DEFAULT_CS, &dev);
+	if (ret) {
+		printf("OTP MAC: QSPI flash probe failed (%d)\n", ret);
+		return;
+	}
+	flash = dev_get_uclass_priv(dev);
+
+	/* Read the JEDEC ID ourselves; struct flash_info is private */
+	op = (struct spi_mem_op)SPI_MEM_OP(SPI_MEM_OP_CMD(0x9f, 1),
+					   SPI_MEM_OP_NO_ADDR,
+					   SPI_MEM_OP_NO_DUMMY,
+					   SPI_MEM_OP_DATA_IN(3, jedec, 1));
+	ret = spi_claim_bus(flash->spi);
+	if (ret)
+		return;
+	ret = spi_mem_exec_op(flash->spi, &op);
+	spi_release_bus(flash->spi);
+	if (ret) {
+		printf("OTP MAC: JEDEC ID read failed (%d)\n", ret);
+		return;
+	}
+
+	id = jedec[0] << 16 | jedec[1] << 8 | jedec[2];
+	switch (id) {
+	case 0x012018:	/* Spansion S25FL128S */
+	case 0x20ba18:	/* Micron N25Q128A / MT25QL128ABA */
+		opcode = OTP_READ_SPANSION_MICRON;
+		addr = OTP_BASE_SPANSION_MICRON;
+		break;
+	case 0xef4018:	/* Winbond W25Q128FV/BV */
+	case 0xef7018:	/* Winbond W25Q128JV */
+		opcode = OTP_READ_WINBOND;
+		addr = OTP_BASE_WINBOND;
+		break;
+	default:
+		printf("OTP MAC: flash id %06x not supported\n", id);
+		return;
+	}
+	addr += CONFIG_ZYNQ_GEM_SPI_MAC_OFFSET;
+
+	/* OTP reads are always 1-1-1, 3 address bytes, 8 dummy clocks */
+	op = (struct spi_mem_op)SPI_MEM_OP(SPI_MEM_OP_CMD(opcode, 1),
+					   SPI_MEM_OP_ADDR(3, addr, 1),
+					   SPI_MEM_OP_DUMMY(1, 1),
+					   SPI_MEM_OP_DATA_IN(ARP_HLEN, mac, 1));
+
+	ret = spi_claim_bus(flash->spi);
+	if (ret)
+		return;
+	ret = spi_mem_exec_op(flash->spi, &op);
+	spi_release_bus(flash->spi);
+	if (ret) {
+		printf("OTP MAC: read failed (%d)\n", ret);
+		return;
+	}
+
+	if (!is_valid_ethaddr(mac)) {
+		printf("OTP MAC: no valid address in OTP (%pM)\n", mac);
+		return;
+	}
+
+	printf("OTP MAC: %pM\n", mac);
+	eth_env_set_enetaddr("ethaddr", mac);
+}
+#endif
+
 int board_late_init(void)
 {
 	int env_targets_len = 0;
@@ -52,6 +142,10 @@ int board_late_init(void)
 	char *new_targets;
 	char *env_targets;
 
+#if IS_ENABLED(CONFIG_ZYNQ_GEM_SPI_MAC_OTP)
+	zynq_read_qspi_otp_mac();
+#endif
+
 	if (!(gd->flags & GD_FLG_ENV_DEFAULT)) {
 		debug("Saved variables - Skipping\n");
 		return 0;
